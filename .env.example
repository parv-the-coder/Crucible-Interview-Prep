# ---------------------------------------------------------------- app ---
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:5173"]

# ----------------------------------------------------------- database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=crucible
POSTGRES_PASSWORD=crucible
POSTGRES_DB=crucible

# ----------------------------------------------------------- security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-do-not-ship-0123456789
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# ------------------------------------------------------------ sandbox ---
# "docker" for real isolation; "subprocess" is a DEV-ONLY fallback that runs
# untrusted code with rlimits but no kernel namespace isolation.
SANDBOX_BACKEND=docker
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_MB=256
SANDBOX_PIDS_LIMIT=64
SANDBOX_POOL_ENABLED=true

# ----------------------------------------------------------------- ai ---
AI_ENABLED=true
AI_PROVIDER=gemini
# Free tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_DAILY_BUDGET_PER_USER=50

